<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Native reconstruction of AIROOM's warm paper / lamplight design system.
         Values mirror the macOS StudioTheme port exactly. -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="StudioBackgroundColor">#F6F0E7</Color>
            <Color x:Key="StudioSidebarColor">#F0E7DA</Color>
            <Color x:Key="StudioSurfaceColor">#FFFDF8</Color>
            <Color x:Key="StudioSecondaryColor">#FAF5EE</Color>
            <Color x:Key="StudioBorderColor">#E3DACD</Color>
            <Color x:Key="StudioInkColor">#332921</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="StudioBackgroundColor">#1A1613</Color>
            <Color x:Key="StudioSidebarColor">#211C18</Color>
            <Color x:Key="StudioSurfaceColor">#26211D</Color>
            <Color x:Key="StudioSecondaryColor">#2E2621</Color>
            <Color x:Key="StudioBorderColor">#423830</Color>
            <Color x:Key="StudioInkColor">#F2EBE0</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="StudioBackgroundColor">#1A1613</Color>
            <Color x:Key="StudioSidebarColor">#211C18</Color>
            <Color x:Key="StudioSurfaceColor">#26211D</Color>
            <Color x:Key="StudioSecondaryColor">#2E2621</Color>
            <Color x:Key="StudioBorderColor">#423830</Color>
            <Color x:Key="StudioInkColor">#F2EBE0</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Accent hues shared by both schemes. -->
    <Color x:Key="StudioAmberColor">#DB964A</Color>
    <Color x:Key="StudioOrangeColor">#D9692F</Color>
    <Color x:Key="StudioVioletColor">#7A6ED6</Color>
    <Color x:Key="StudioMossColor">#3D8A5C</Color>
    <Color x:Key="StudioWarningColor">#A66E24</Color>

    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="{ThemeResource StudioBackgroundColor}" />
    <SolidColorBrush x:Key="StudioSidebarBrush" Color="{ThemeResource StudioSidebarColor}" />
    <SolidColorBrush x:Key="StudioSurfaceBrush" Color="{ThemeResource StudioSurfaceColor}" />
    <SolidColorBrush x:Key="StudioSecondaryBrush" Color="{ThemeResource StudioSecondaryColor}" />
    <SolidColorBrush x:Key="StudioBorderBrush" Color="{ThemeResource StudioBorderColor}" />
    <SolidColorBrush x:Key="StudioInkBrush" Color="{ThemeResource StudioInkColor}" />
    <SolidColorBrush x:Key="StudioAmberBrush" Color="{ThemeResource StudioAmberColor}" />
    <SolidColorBrush x:Key="StudioOrangeBrush" Color="{StaticResource StudioOrangeColor}" />
    <SolidColorBrush x:Key="StudioVioletBrush" Color="{StaticResource StudioVioletColor}" />
    <SolidColorBrush x:Key="StudioMossBrush" Color="{StaticResource StudioMossColor}" />
    <SolidColorBrush x:Key="StudioWarningBrush" Color="{StaticResource StudioWarningColor}" />

    <!-- The app's own brush keys mapped onto the theme, so common controls pick
         up the warm paper look without restyling every control. -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{ThemeResource StudioBackgroundColor}" />
    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="{ThemeResource StudioInkColor}" />

    <x:Double x:Key="StudioRadius">14</x:Double>

    <Style x:Key="StudioPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StudioSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource StudioRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="StudioEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{StaticResource StudioWarningBrush}" />
    </Style>

    <Style x:Key="StudioTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource StudioInkBrush}" />
    </Style>

    <Style x:Key="StudioSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource StudioInkBrush}" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StudioBubbleUser" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StudioAmberBrush}" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="StudioBubbleAgent" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StudioSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
