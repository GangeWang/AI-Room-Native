<Window
    x:Class="AIROOMApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AIROOMApp.Views">

    <Grid Background="{ThemeResource StudioBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Warm title bar -->
        <Grid x:Name="TitleBar" Height="44" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="16" Height="16" Fill="{StaticResource StudioOrangeBrush}" Opacity="0.9" />
                <TextBlock Text="AI Room Native" FontWeight="SemiBold" Foreground="{ThemeResource StudioInkBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="Nav"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="196"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource StudioSidebarColor}" />
            </NavigationView.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    x:Name="StatusBanner"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Warning"
                    CloseButtonClick="OnStatusBannerClosed" />
                <Frame x:Name="ContentFrame" Grid.Row="1" Padding="22,14,22,14" Background="Transparent" />
            </Grid>
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="workstation" Content="成員工位" Icon="People" />
                <NavigationViewItem Tag="lounge" Content="茶歇室">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE95F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="attention" x:Name="AttentionItem" Content="待你處理">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="members" Content="成員" Icon="Contact" />
                <NavigationViewItem Tag="settings" Content="設定" Icon="Setting" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="StopAllItem" Content="全部中止" Tapped="OnStopAllTapped">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
        </NavigationView>

        <!-- System tray icon is deferred: H.NotifyIcon's WinUI IconSource path
             crashes inside System.Drawing (async void), to be replaced with a
             direct Shell_NotifyIcon implementation in the next phase. -->
    </Grid>
</Window>
