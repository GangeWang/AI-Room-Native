<Window
    x:Class="AIROOMApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:views="using:AIROOMApp.Views">

    <Grid Background="{ThemeResource StudioBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Warm title bar -->
        <Grid x:Name="TitleBar" Height="44" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="16" Height="16" Fill="{StaticResource StudioOrangeBrush}" Opacity="0.9" />
                <TextBlock Text="AIROOM Native" FontWeight="SemiBold" Foreground="{ThemeResource StudioInkBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="Nav"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="196"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource StudioSidebarColor}" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="workstation" Content="成員工位" Icon="People" />
                <NavigationViewItem Tag="attention" x:Name="AttentionItem" Content="待你處理">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="members" Content="成員" Icon="Contact" />
                <NavigationViewItem Tag="settings" Content="設定" Icon="Setting" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="StopAllItem" Content="全部中止" Tapped="OnStopAllTapped">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Padding="22,14,22,14" Background="Transparent" />
        </NavigationView>

        <!-- System tray -->
        <tb:TaskbarIcon
            x:Name="Tray"
            ToolTipText="AIROOM Native"
            IconSource="ms-appx:///Assets/airoom.ico"
            LeftClickCommand="{x:Bind ShowFromTrayCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="顯示 AIROOM" Click="OnTrayShow" />
                    <MenuFlyoutItem Text="全部中止" Click="OnTrayStopAll" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="離開" Click="OnTrayExit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
