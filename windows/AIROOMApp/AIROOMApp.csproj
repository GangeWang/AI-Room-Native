<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>AIROOMApp</RootNamespace>
    <!-- The exe's own icon (Explorer, taskbar, shortcuts). The running window
         points at the same file via AppWindow.SetIcon; Scripts/make-ico.ps1
         rebuilds it from the shared artwork. -->
    <ApplicationIcon>Assets\airoom.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged + self-contained: no Windows App SDK runtime install needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>zh-Hant</DefaultLanguage>
    <Version>0.3.0</Version>
    <AssemblyName>AIROOM</AssemblyName>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.5762" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIROOMCore\AIROOMCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\airoom.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The CC BY-NC-SA artwork is committed once, beside the macOS app; both
         platforms bundle the same files (Scripts/fetch-assets.ps1 is the
         original downloader, kept for reference). -->
    <Content Include="..\..\macos\Sources\AIROOMNative\Resources\*.webp">
      <Link>Assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\macos\Sources\AIROOMNative\Resources\*.jpg">
      <Link>Assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\macos\Sources\AIROOMNative\Resources\airoom.png">
      <Link>Assets\airoom.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
