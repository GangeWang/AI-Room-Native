<Page
    x:Class="AIROOMApp.Views.MembersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="成員" Style="{StaticResource StudioTitle}" />
                <Button Content="＋ 新增成員" Click="OnAddMember" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer MaxHeight="640">
                <StackPanel x:Name="CardList" Spacing="10" />
            </ScrollViewer>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Margin="14,0,0,0">
            <ContentControl x:Name="EditorHost" IsEnabled="False">
                <StackPanel x:Name="Editor" Spacing="10" />
            </ContentControl>
        </ScrollViewer>
    </Grid>
</Page>
