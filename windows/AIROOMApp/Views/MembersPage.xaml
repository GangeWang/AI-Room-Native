<Page
    x:Class="AIROOMApp.Views.MembersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="980" HorizontalAlignment="Left" Spacing="21">
            <StackPanel Spacing="6">
                <TextBlock Text="MEMBERS" Style="{StaticResource StudioEyebrow}" />
                <TextBlock Text="團隊與人物卡" Style="{StaticResource StudioTitle}" />
                <TextBlock Text="人物形象與個性在這裡設定；登入資料由官方 CLI 管理。" Opacity="0.7" />
            </StackPanel>

            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled">
                <StackPanel x:Name="CardList" Orientation="Horizontal" Spacing="16" />
            </ScrollViewer>

            <ContentControl x:Name="EditorHost" IsEnabled="False" HorizontalAlignment="Stretch">
                <StackPanel x:Name="Editor" Spacing="10" />
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
