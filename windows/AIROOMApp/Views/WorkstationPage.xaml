<Page
    x:Class="AIROOMApp.Views.WorkstationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AIROOMApp.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Members -->
        <Border Style="{StaticResource StudioPanel}" Padding="10" Margin="0,0,14,0">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="成員" Style="{StaticResource StudioEyebrow}" Margin="8,4,0,0" />
                <ListView
                    Grid.Row="1"
                    x:Name="MemberList"
                    SelectionMode="Single"
                    SelectionChanged="OnMemberSelected" />
                <TextBlock
                    Grid.Row="2"
                    x:Name="CallUsageText"
                    TextWrapping="Wrap"
                    Margin="8,0,8,4"
                    FontSize="11"
                    Opacity="0.7" />
            </Grid>
        </Border>

        <!-- Topic -->
        <Border Grid.Column="1" Style="{StaticResource StudioPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="18,14,18,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="TopicPicker"
                        HorizontalAlignment="Stretch"
                        MinWidth="220"
                        SelectionChanged="OnTopicPicked" />
                    <Button Grid.Column="1" Content="新話題" Click="OnNewTopic" />
                    <Button Grid.Column="2" Content="改標題" Click="OnRenameTopic" />
                    <ComboBox
                        Grid.Column="3"
                        x:Name="ModelPicker"
                        MinWidth="130"
                        SelectionChanged="OnModelPicked" />
                    <ComboBox
                        Grid.Column="4"
                        x:Name="EffortPicker"
                        MinWidth="96"
                        SelectionChanged="OnEffortPicked" />
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="18,4,18,8" x:Name="ChatScroll">
                    <StackPanel x:Name="ChatPanel" Spacing="10" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" x:Name="DeskBar" Visibility="Collapsed"
                            Orientation="Horizontal" Spacing="8" Padding="18,6,18,0">
                    <TextBlock x:Name="DeskChangesText" VerticalAlignment="Center" />
                    <Button x:Name="ApplyDeskButton" Content="應用到原資料夾" Click="OnApplyDesk" />
                    <Button x:Name="UndoDeskButton" Content="撤銷上一輪" Click="OnUndoDesk" />
                    <Button x:Name="DiscardDeskButton" Content="丟棄工作副本" Click="OnDiscardDesk" />
                </StackPanel>

                <Grid Grid.Row="3" Padding="18,8,18,16" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="InputBox"
                        MinHeight="74"
                        MaxHeight="180"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        PlaceholderText="跟成員說話（Enter 送出，Shift+Enter 換行）"
                        TextChanged="OnInputChanged"
                        KeyDown="OnInputKeyDown" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="6" VerticalAlignment="Top">
                        <Button x:Name="SendButton" Content="送出" Click="OnSend" HorizontalAlignment="Stretch" />
                        <Button x:Name="StopButton" Content="停止" Click="OnStop" HorizontalAlignment="Stretch" />
                        <Button Content="附件…" Click="OnAttach" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" MaxHeight="120" HorizontalAlignment="Left">
                        <StackPanel x:Name="DraftAttachmentsPanel" Orientation="Horizontal" Spacing="6" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Empty state -->
        <TextBlock
            Grid.ColumnSpan="2"
            x:Name="EmptyState"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="還沒有成員。先到「成員」頁新增一位，或到「設定」確認官方 CLI 已就緒。"
            Style="{StaticResource StudioSubtitle}" />
    </Grid>
</Page>
