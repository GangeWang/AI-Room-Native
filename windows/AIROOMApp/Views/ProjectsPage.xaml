<Page
    x:Class="AIROOMApp.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Projects -->
        <Border Style="{StaticResource StudioPanel}" Padding="12" Margin="0,0,14,0">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="專案" Style="{StaticResource StudioEyebrow}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="NewFlowButton" Content="新增專案" Click="OnNewFlow" />
                    <Button Grid.Column="2" x:Name="DeleteFlowButton" Content="刪除" Click="OnDeleteFlow" />
                </Grid>
                <ListView
                    Grid.Row="1"
                    x:Name="FlowList"
                    Margin="0,4,0,0"
                    SelectionMode="Single"
                    SelectionChanged="OnFlowSelected" />
                <TextBlock
                    Grid.Row="2"
                    Text="先在副本執行，逐檔驗收後才能寫回原資料夾。"
                    FontSize="11"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Detail -->
        <Border Grid.Column="1" Style="{StaticResource StudioPanel}" Padding="0">
            <ScrollViewer x:Name="StageScroll" Padding="22,16,22,20">
                <StackPanel x:Name="Stage" Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
