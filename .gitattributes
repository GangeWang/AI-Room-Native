# One repo, two platforms: keep each file's line endings fixed whatever the
# checkout machine's core.autocrlf says.
* text=auto eol=lf

# Windows-native files keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf
*.csproj  text eol=crlf

# Binary
*.webp binary
*.png  binary
*.jpg  binary
*.icns binary
*.ico  binary
*.dmg  binary
*.exe  binary
*.msi  binary
*.msix binary
